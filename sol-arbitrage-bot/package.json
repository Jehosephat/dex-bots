{
  "name": "sol-arbitrage-bot",
  "version": "1.0.0",
  "description": "Cross-Chain Arbitrage Bot (SOL → GalaChain) - MVP Implementation",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "watch": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "clean": "rm -rf dist",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop sol-arbitrage-bot",
    "pm2:restart": "pm2 restart sol-arbitrage-bot",
    "pm2:logs": "pm2 logs sol-arbitrage-bot"
  },
  "keywords": [
    "arbitrage",
    "galachain",
    "solana",
    "trading",
    "bot",
    "cross-chain",
    "defi"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@gala-chain/api": "^2.5.1",
    "@gala-chain/dex": "^1.0.26",
    "@gala-chain/gswap-sdk": "^0.0.7",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "axios": "^1.6.0",
    "bignumber.js": "^9.3.1",
    "bs58": "^6.0.0",
    "dotenv": "^17.2.3",
    "ethers": "^6.15.0",
    "json-stringify-deterministic": "^1.0.12",
    "p-retry": "^7.0.0",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.0",
    "@types/node": "^24.7.0",
    "@typescript-eslint/eslint-plugin": "^8.44.0",
    "@typescript-eslint/parser": "^8.44.0",
    "eslint": "^9.36.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
