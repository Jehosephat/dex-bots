# SOL Arbitrage Bot Environment Configuration

# Logging
LOG_LEVEL=info
LOG_FILE=logs/arbitrage-bot.log
NODE_ENV=development

# GalaChain Configuration
GALA_CHAIN_RPC_URL=https://api.galachain.io
GALA_CHAIN_WALLET_ADDRESS=eth|0x...
GALA_CHAIN_PRIVATE_KEY=0x...

# Solana Configuration
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WALLET_ADDRESS=...
SOLANA_PRIVATE_KEY=...

# Bridge Configuration
BRIDGE_API_URL=https://bridge.galachain.io
BRIDGE_API_KEY=...

# Trading Configuration
MIN_EDGE_BPS=30
MAX_SLIPPAGE_BPS=50
RISK_BUFFER_BPS=10

# Bridge Settings
BRIDGE_INTERVAL_MINUTES=30
BRIDGE_THRESHOLD_USD=100

# Monitoring
ENABLE_ALERTS=true
ALERT_WEBHOOK_URL=
